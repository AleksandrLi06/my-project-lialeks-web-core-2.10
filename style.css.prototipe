.main-container {
    padding: 50px 50px;
   background-color: #F8F8F8;
}

.services {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

h1 {
    width: 266px;
    height: 40px;
    top: 42px;
    left: 2px;
    border-left: 3px solid #41F6D7;
    padding-left: 20px;
    border-radius: 2px;
}

.nav-section {
    display: flex;   
}

.services-section {
    color: #1B1C21;
    display: flex;
    justify-content: center;
    align-items: center;
}
.services-section:focus{
    border: none;
    background-color: #F8F8F8;
}

.navigation {
    display: flex;
    align-items: center;
}
.nav-btn {
    font-size: 18px;
    padding: 10px;
}


.icons {
    width: 40px;
    height: 40px;
    padding: 6px;
}
.nav-btn {
    font-size: 18px;
    padding: 10px;
}
li {
    list-style: none;
}

.main {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.text {
    width: 490;
height: 160;
top: 188.22px;
}
.info {
    color: #1B1C21;
}

.latter-btn {
    font-size: 18px;
    color: #1B1C21;
    gap: 10px;
}
.Downarrow {
    width: 12px;
    height: 12px;
}
button {
    border: none;
    background-color: #F8F8F8;
    color: #7E7E82;
}
button:focus{
    border: 2px solid #B8FFEC;
    background-color: white;
}

.fon-img {
width: 100%;
height: 100%;
}

.tablet-bar {
    display: none;
}
.phone-bar {
    display: none;
}

@media (min-width: 598px) and (max-width: 1024px) {
    .tablet-bar {
        display: flex;
        justify-content: space-between;
        background-color: white;
        position: sticky;
        width: 0;
        height: 88px;
        padding: 0;
    }
    .tablet-bar__icons {
        display: flex;
        align-items: center;
        gap: 75%;
    }
    .left {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }
    .right {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }
    
    .divider {
    border-left: 2px solid #EAEAEA;
    height: 30px;
    }

    .nav-section {
        display: none;
    }

    .main-container {
        width: 100%;
        max-width: 1024px;
        min-width: 768px;
        padding: 10px 10px;
    }

    h1 {
        width: 257px;
        height: 40px;
    }

    .navigation {
        display: flex;
        max-width: 1024px;
        overflow: scroll;
        overflow: hidden;
        flex-wrap: nowrap;
        /* width: 992px; */
        /* height: 40px; */
        /* margin: 24px; */
        /* width: 100%;
        height: 40px; */
        padding: 16px;
    }
    .navigation li {
        width: 248px;
        height: 40px;
    }

     .reviews {
        display: none;
    }

    .nav-btn {
        width: 248px;
        height: 40px;
    }

    .main {
        width: 720px;
        height: 208px;
        margin: 32px;
    }

    .text {
        /* width: 568px;
        height: 190px; */
        width: 512px;
    }

    .fon-img {
        /* width: 375px;
        height: 221px; */
        width: 430px;
    }

    .latter-btn {
        margin: 10px;
    }
}

@media (min-width: 320px) and (max-width: 597px) {
    .phone-bar {
        display: flex;
        width: 564px;
        background-color: white;
        position: sticky;
        box-sizing: border-box;
        padding: 24px;
    }
    .phone-bar__icons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        width: 100%;
        max-width: 597px;
        min-width: 320px;
    }

    .divider {
    border-left: 2px solid #EAEAEA;
    height: 30px;
    }

    .main-container {
        width: 564px;
        padding: 0%;
    }

    h1 {
        width: 304px;
        height: 40px;
    }
    .nav-section {
        display: none;
    }

    .main {
        display: block;
        max-width: 767px;
        min-width: 300px;
    }

    .info-2 {
        display: none;
    }
    .info-2:has(+ .latter-btn:focus) {
        display: block;
    }

    .navigation {
        display: flex;
        max-width: 767px;
        overflow: scroll;
        overflow: hidden;
        flex-wrap: nowrap;
        width: 504px;
        height: 40px;
        padding: 16px;
    }
    .navigation li {
        width: 246px;
        height: 40px;
    }
    
    .reviews {
        display: none;
    }

    .main {
        padding: 24px;
    }

    nav {
        max-width: 100%;
        width: 767px;
    }
    ul li {
        flex-shrink: 0;
    }

    .latter-btn {
        margin: 16px;
    }

}
